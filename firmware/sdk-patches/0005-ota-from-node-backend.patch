+// Vesper (task 13): an update from the node's own server. ota_start's version
+// gate still applies (never an image whose version is not newer than the
+// running one, no force), and on top of it:
+//   - the request carries `headers` (the node's bearer and credential) and
+//     follows no redirect, so they never leave the configured server;
+//   - the image's descriptor must carry exactly `expected_version`;
+//   - exactly `expected_size` bytes must arrive, and what was written to the
+//     update slot must hash to `expected_sha256` (the server's manifest),
+//     checked by reading the slot back BEFORE esp_https_ota_finish() verifies
+//     the image (its own SHA-256 and signature) and switches the boot partition;
+//   - nothing is installed while the running image is still PENDING_VERIFY
+//     (that would overwrite the only known-good slot).
+// Everything is copied before this returns (the caller may wipe its buffers);
+// the copies of the header values are wiped when the OTA ends.
+typedef struct {
+    const char *name;
+    const char *value;
+} ota_header_t;
+
+#define OTA_REQUEST_MAX_HEADERS 6
+
+typedef struct {
+    const char *url;
+    const ota_header_t *headers;
+    size_t nheaders;                 // at most OTA_REQUEST_MAX_HEADERS
+    const char *expected_version;    // required
+    const uint8_t *expected_sha256;  // required, 32 bytes
+    size_t expected_size;            // required, > 0
+} ota_request_t;
+
+void ota_start_request(const ota_request_t *req, ota_status_cb cb, void *user);
