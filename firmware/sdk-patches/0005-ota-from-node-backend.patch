+static void request_fail(ota_status_cb cb, void *user, const char *detail) {
+    ESP_LOGE(TAG, "could not start OTA: %s", detail);
+    if (cb) {
+        ota_event_t ev = { .result = OTA_RESULT_FAILED, .detail = detail };
+        cb(&ev, user);
+    }
+}
+
+void ota_start_request(const ota_request_t *req, ota_status_cb cb, void *user) {
+    if (!req || !req->url || !*req->url || !req->expected_version ||
+        strlen(req->expected_version) >= sizeof(((ota_ctx_t *)0)->expected_version) ||
+        !req->expected_sha256 || !req->expected_size ||
+        req->nheaders > OTA_REQUEST_MAX_HEADERS || (req->nheaders && !req->headers)) {
+        request_fail(cb, user, "bad request");
+        return;
+    }
+    if (s_request_busy) {
+        request_fail(cb, user, "an update is already running");
+        return;
+    }
+    ota_ctx_t *ctx = calloc(1, sizeof(*ctx));
+    if (!ctx) {
+        request_fail(cb, user, "out of memory");
+        return;
+    }
+    ctx->checked = true;
+    s_request_busy = true;
+    ctx->cb = cb;
+    ctx->user = user;
+    ctx->url = strdup(req->url);
+    bool ok = ctx->url != NULL;
+    for (size_t i = 0; ok && i < req->nheaders; i++) {
+        ctx->hdr_name[i] = strdup(req->headers[i].name ? req->headers[i].name : "");
+        ctx->hdr_value[i] = strdup(req->headers[i].value ? req->headers[i].value : "");
+        ok = ctx->hdr_name[i] && ctx->hdr_value[i];
+    }
+    ctx->nheaders = req->nheaders;
+    strlcpy(ctx->expected_version, req->expected_version, sizeof(ctx->expected_version));
+    memcpy(ctx->expected_sha256, req->expected_sha256, sizeof(ctx->expected_sha256));
+    ctx->expected_size = req->expected_size;
+    if (!ok) {
+        ctx_free(ctx);
+        request_fail(cb, user, "out of memory");
+        return;
+    }
+    if (xTaskCreate(ota_task, "ota", 16384, ctx, 5, NULL) != pdPASS) {
+        ctx_free(ctx);
+        request_fail(cb, user, "could not start ota task");
+    }
+}
