+// SHA-256 of the first `size` bytes of `part` (what esp_https_ota wrote).
+static bool slot_sha256_matches(const esp_partition_t *part, size_t size, const uint8_t want[32]) {
+    // The legacy mbedtls SHA-256 API (hardware-accelerated; IDF's own core
+    // dump code uses it the same way).
+    mbedtls_sha256_context ctx;
+    mbedtls_sha256_init(&ctx);
+    bool ok = mbedtls_sha256_starts(&ctx, 0) == 0;
+    static uint8_t buf[1024];   // only the one request-mode OTA task uses it
+    for (size_t at = 0; ok && at < size;) {
+        size_t n = size - at > sizeof(buf) ? sizeof(buf) : size - at;
+        ok = esp_partition_read(part, at, buf, n) == ESP_OK &&
+             mbedtls_sha256_update(&ctx, buf, n) == 0;
+        at += n;
+    }
+    uint8_t got[32];
+    ok = ok && mbedtls_sha256_finish(&ctx, got) == 0;
+    mbedtls_sha256_free(&ctx);
+    if (!ok) return false;
+    uint8_t diff = 0;
+    for (int i = 0; i < 32; i++) diff |= got[i] ^ want[i];
+    return diff == 0;
+}
