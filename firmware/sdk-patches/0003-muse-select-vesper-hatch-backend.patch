diff --git a/esp32/components/muse/Kconfig b/esp32/components/muse/Kconfig
index 3c1f3188f2a4a1c0b14f0ffbbe30014b230f9776..2b083a1ad17bd5b184f4ccd5bbb8c1cbadffa432 100644
--- a/esp32/components/muse/Kconfig
+++ b/esp32/components/muse/Kconfig
@@ -106,16 +106,34 @@ menu "Muse"
             Leave disabled to build without camera support.
 
     config MUSE_HATCH
-        bool "Muse's own voice session"
+        bool "Muse's own voice session (the Vesper node backend)"
         depends on MUSE_ENABLED
         default y if SPIRAM
         default n
         help
-            Push-to-talk turns go over a voice session of Muse's own, to the
-            VM Home Link is paired with or one set up on the device with a
-            device token. Replies are text, shown as captions; start_tts in
-            muse_chat_session.cpp is where a TTS API of your own can speak
-            them. Needs PSRAM. Without it, voice notes go over Home Link's own
-            session to its paired VM and replies are shown as text.
+            Push-to-talk turns go to the Vesper node backend
+            (components/muse/vesper/, muse-charm docs/node-wire-protocol.md):
+            each note is POSTed to <server URL>/turn and the reply streams
+            back as SSE captions. Needs PSRAM; boards without it are not
+            supported by the Vesper patch set.
+
+    config VESPER_NODE_URL
+        string "Vesper node server base URL (default)"
+        depends on MUSE_HATCH
+        default ""
+        help
+            Used when NVS muse:host is unset, e.g.
+            https://peggy.fly.dev/vesper-node. Normally set on the device
+            instead: serial console ">hatch.host=<url>".
+
+    config VESPER_NODE_TOKEN
+        string "Vesper node bearer token (default; leave empty)"
+        depends on MUSE_HATCH
+        default ""
+        help
+            Used when NVS muse:node_token is unset. Leave this empty in any
+            committed configuration: it would be compiled into the image in
+            plain text. Provision the token on the device instead: serial
+            console ">hatch.token=<token>" (never echoed).
 
 endmenu
