+
+/*
+ * The listen after a wake (vesper_wake.h). It looks like a press (LISTENING,
+ * a caption), but:
+ *  - nothing from before the wake word is used: the pre-roll ring is never
+ *    read here, the note starts at the detection;
+ *  - the note is recorded locally, and Hatch (the backend) is not contacted,
+ *    not even muse_hatch_turn_begin(), until the speech onset; then the note
+ *    goes from 300 ms before the onset (never before the detection), and the
+ *    rest streams as in record();
+ *  - it ends on 1 s of trailing silence or at MAX_SECS (there's no release);
+ *    with no speech within 5 s it ends with nothing sent.
+ */
+static wake_rec_t wake_record(void)
+{
+    muse_state_set_mode(MUSE_MODE_LISTENING);
+    muse_state_set_progress(0);
+    muse_state_set_caption("LISTENING...");
+    s_rec_n = s_sent = 0;
+    s_live = s_tried = false;
+    vw_config_t cfg;
+    vw_config_default(&cfg);
+    cfg.max_chunks = MAX_FRAMES / MUSE_AUDIO_CHUNK;
+    vw_listen_t l;
+    vw_listen_start(&l, &cfg, vesper_wakenet_floor_db());
+    rec_stats_t st = { 0 };
+    bool heard = false, gave_up = false;
+    char text[96];
+    vw_verdict_t v = VW_WAITING;
+    while (v != VW_END_SILENCE && v != VW_END_MAX) {
+        if (press_waiting()) {
+            return WAKE_PRESSED;
+        }
+        if (s_rec_n + MUSE_AUDIO_CHUNK > MAX_FRAMES || muse_audio_read(s_chunk, MUSE_AUDIO_CHUNK) != ESP_OK) {
+            break;
+        }
+        muse_state_set_level(muse_audio_level(s_chunk, MUSE_AUDIO_CHUNK));
+        v = vw_listen_chunk(&l, muse_audio_dbfs(s_chunk, MUSE_AUDIO_CHUNK));
+        take(&st, s_chunk);   /* into s_rec; to Hatch only once live */
+        if (v == VW_NO_SPEECH) {
+            return WAKE_QUIET;
+        }
+        if (!vw_listen_may_contact_backend(&l)) {
+            continue;
+        }
+        if (v == VW_ONSET) {
+            /* The note starts shortly before the speech; what came before it (quiet since the
+             * wake) is dropped unsent. Then on to Hatch as a press would. */
+            size_t lead = (size_t)vw_listen_lead(&l) * MUSE_AUDIO_CHUNK;
+            lead = lead < s_rec_n ? lead : s_rec_n;
+            memmove(s_rec, s_rec + lead, (s_rec_n - lead) * sizeof(int16_t));
+            s_rec_n -= lead;
+            st = (rec_stats_t){ 0 };
+            for (size_t i = 0; i + MUSE_AUDIO_CHUNK <= s_rec_n; i += MUSE_AUDIO_CHUNK) {
+                keep(&st, s_rec + i, MUSE_AUDIO_CHUNK);
+            }
+            ESP_LOGI(TAG, "wake: speech after %.2fs", (double)l.chunks * MUSE_AUDIO_CHUNK / MUSE_AUDIO_RATE);
+            if (press_waiting()) {
+                return WAKE_PRESSED;   /* a press on the onset chunk: never begin a turn only to cancel it */
+            }
+            if (muse_hatch_ready() && !s_held_count) {
+                go_live();
+            }
+            muse_state_set_caption(s_live ? "LISTENING..." : "RECORDING...");
+        }
+        muse_hatch_ev_t ev;
+        while (s_live && (ev = muse_hatch_turn_event(text, sizeof(text))) != MUSE_HATCH_EV_NONE) {
+            if (ev == MUSE_HATCH_EV_HEARD && text[0]) {
+                heard = true;
+                muse_state_set_caption("%s", text);
+            } else if (ev == MUSE_HATCH_EV_ERROR) {
+                ESP_LOGW(TAG, "muse: %s", text);
+                muse_hatch_turn_cancel();
+                s_live = false;
+                gave_up = true;   /* the kept note goes later */
+            }
+        }
+        bool tick = l.chunks % 5 == 0;
+        if (tick && !s_live && !gave_up && !s_held_count && muse_hatch_ready()) {
+            if (press_waiting()) {
+                return WAKE_PRESSED;   /* likewise: the press goes first, no turn begun for it */
+            }
+            ESP_LOGI(TAG, "Muse in reach: streaming the note so far");
+            go_live();
+        }
+        muse_state_set_progress((float)s_rec_n / MAX_FRAMES);
+        if (!heard && tick) {
+            muse_state_set_caption("%s %.1fs", s_live ? "LISTENING" : "RECORDING", (double)s_rec_n / MUSE_AUDIO_RATE);
+        }
+    }
+    muse_state_set_level(0);
+    if (!vw_listen_may_contact_backend(&l)) {
+        return WAKE_QUIET;   /* the mic failed before any speech: nothing was sent */
+    }
+    float rms_db = st.frames ? 10.0f * log10f((float)(st.acc / st.frames / (32768.0 * 32768.0)) + 1e-10f) : -100.0f;
+    ESP_LOGI(TAG, "wake: recorded %.2fs (%s): rms %.1f dBFS, peak %.1f dBFS, room floor %.1f dBFS",
+             (double)s_rec_n / MUSE_AUDIO_RATE, v == VW_END_MAX ? "max" : "silence", rms_db < -100.0f ? -100.0f : rms_db,
