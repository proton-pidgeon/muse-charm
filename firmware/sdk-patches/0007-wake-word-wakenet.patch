+        char *json = heap_caps_malloc(VESPER_WAKE_JSON_MAX, MUSE_BIG_CAPS);
+        if (json) {
+            vesper_wakenet_status_json(json, VESPER_WAKE_JSON_MAX);
+            printf("@wake %s\n", json);
+            free(json);
+        }
+    } else if (!strncmp(line, "wake=", 5)) {
