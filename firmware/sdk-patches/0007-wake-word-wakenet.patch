+            printf("@wake.error expected >wake=on or >wake=off\n");
+        } else {
+            bool saved = vesper_wakenet_set_on(on);
+            printf("@wake %s%s\n", on ? "on" : "off", saved ? "" : " (not saved: NVS write failed)");
+        }
+    } else if (!strncmp(line, "wake.threshold=", 15)) {
+        int permille;
+        vw_parse_t r = vw_parse_threshold(line + 15, &permille);
+        if (r == VW_PARSE_INVALID) {
+            int now = vesper_wakenet_threshold();
+            printf("@wake.error expected >wake.threshold=<0.50-0.99>, e.g. 0.65 (now %d.%03d)\n", now / 1000,
+                   now % 1000);
+        } else {
+            bool saved = vesper_wakenet_set_threshold(permille);
+            printf("@wake.threshold %d.%03d%s%s\n", permille / 1000, permille % 1000,
+                   r == VW_PARSE_CLAMPED ? " (clamped to 0.50-0.99)" : "", saved ? "" : " (not saved: NVS write failed)");
+        }
+    } else {
+        printf("@wake.error unknown: >wake, >wake=on|off, >wake.threshold=<0.50-0.99>\n");
+    }
